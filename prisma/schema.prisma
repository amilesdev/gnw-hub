// GNW Worship Hub — Prisma schema
// Use `prisma migrate dev` (not db push) per project conventions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  member
  leader
}

enum MemberSection {
  Vocalist
  Band
}

// A member's part within their section. Soprano/Alto/Tenor are vocal;
// Keys/Guitar/Bass/Drums are band. (The valid set depends on `section`.)
enum MemberPart {
  Soprano
  Alto
  Tenor
  Keys
  Guitar
  Bass
  Drums
}

enum UserStatus {
  pending
  active
}

enum EventType {
  service
  rehearsal
  prayer
  holy_talks
  encounter_night
  other
}

enum RepeatCadence {
  once
  weekly
  biweekly
  monthly
}

// The three vocal parts a singer can be assigned to on a service. A subset of
// MemberPart (which also covers band instruments) — assignments are singing-only.
enum VocalPart {
  Soprano
  Alto
  Tenor
}

// === GNW Play ===
// True/False is stored as a degenerate multiple-choice (options ["True","False"]),
// so `type` only distinguishes how the builder/play UI renders it.
enum QuestionType {
  multiple_choice
  true_false
}

enum GameMode {
  classic
  team_battle
  survival
}

// Lifecycle of a leader-initiated group call.
enum CallStatus {
  active
  ended
}

// Who a call is open to. `all_members` = the whole team (default, original
// behavior). `leaders_only` = restricted to explicitly-designated call leaders
// (see User.callLeader) plus whoever started it.
enum CallAudience {
  all_members
  leaders_only
}

enum SessionStatus {
  lobby
  active
  ended
}

// Round lifecycle. The server owns this; clients render from it but never write.
enum RoundStatus {
  answering
  revealing
  between_rounds
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String?
  role           Role           @default(member)
  section        MemberSection?
  part           MemberPart?
  // Profile picture: Supabase Storage public URL (bucket `gnw-media`, under
  // `avatars/<userId>/`). Null → the UI falls back to the member's initial.
  image          String?
  status         UserStatus     @default(pending)
  // Only one super-admin exists; they alone may grant the leader role.
  isSuperAdmin   Boolean        @default(false)
  // Whether this user may join "Leaders Only" calls. DELIBERATELY separate from
  // `role` / the leader tag — it's an explicit, opt-in designation assigned only
  // for the call feature, and defaults to off for everyone until set.
  callLeader     Boolean        @default(false)
  // Whether this user may add/replace/remove a song's four vocal-part audio
  // files (the vocal director). Like `callLeader`, DELIBERATELY separate from
  // `role`: it's one narrow capability, not leadership — it grants nothing over
  // events, setlists, song metadata, band content, or retiring songs. Assigned
  // from the backend only (`npm run set-vocal-director`); there is no in-app
  // switch. See lib/access.ts → canEditVocalParts.
  vocalDirector  Boolean        @default(false)
  // Whether this user may import/replace/remove a song's lyric chart (the
  // administrative assistant). Same shape and intent as `vocalDirector`: one
  // narrow capability, not leadership — it grants nothing over events,
  // setlists, song metadata, vocal parts, band content, or retiring songs.
  // Assigned from the backend only (`npm run set-admin-assistant`); there is no
  // in-app switch. See lib/access.ts → canEditLyricCharts.
  adminAssistant Boolean        @default(false)
  // Whether this user reviews Crossover looks (approve / ask for changes). Same
  // shape as the two above: one narrow capability, granted from the backend
  // only (`npm run set-attire-reviewer`). See lib/access.ts → canReviewLooks.
  attireReviewer Boolean        @default(false)
  // Whether this user moderates chat: deletes anyone's message, removes chat
  // members, archives a chat/topic. Same shape as the three above: granted
  // from the backend only (`npm run set-chat-moderator`). The super admin is
  // always a moderator regardless. See lib/access.ts → canModerateChat.
  chatModerator  Boolean        @default(false)
  // Whether this non-leader may use chat during the soft launch (while
  // CHAT_OPEN_TO_MEMBERS is false), for a member's-eye view while testing.
  // Grants nothing beyond what any member gets once chat opens. Backend only
  // (`npm run set-chat-early-access`). See lib/access.ts → canUseChat.
  chatEarlyAccess Boolean       @default(false)
  inviteToken   String?        @unique
  inviteExpiry   DateTime?
  // Bumped to invalidate every existing JWT for this user at once (password
  // reset, "sign out everywhere"). The live session check compares the token's
  // copy against this; a mismatch forces re-login. See lib/auth.ts.
  tokenVersion   Int            @default(0)
  // Self-serve password reset (active users only). Short-lived, single-use.
  resetToken     String?        @unique
  resetExpiry    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  pushSubscriptions PushSubscription[]

  // GNW Play — all-time wins. Only ever incremented for a game's 1st place;
  // surfaced solely on Play Home + the Play leaderboard (not elsewhere in Hub).
  playPoints Int @default(0)

  questionPacks  QuestionPack[] // packs this user authored
  hostedSessions GameSession[] // game sessions this user hosts
  gamePlayers    GamePlayer[] // this user's seats across sessions

  announcements Announcement[] // announcements this user authored

  startedCalls Call[] // group calls this user (a leader) started

  eventAssignments EventAssignment[] // singing parts this user is assigned on services

  unavailability Unavailability[] // dates this user has marked themselves away

  songLeads     SongLead[] // songs this user is set to lead, per setlist
  lastSongLeads SongLastLead[] // library songs remembering this user as the last lead

  ownedProductionTasks ProductionTask[] @relation("ProductionTaskOwner") // production tasks this user owns
  doneProductionTasks  ProductionTask[] @relation("ProductionTaskDoneBy") // production tasks this user checked off

  crossoverSetSingers CrossoverSetSinger[] // Crossover sets this user sings on
  crossoverLooks      CrossoverLook[] // this user's submitted Crossover looks, one per season

  // Chat. Authorship links are SET NULL (the message stays, shown as a former
  // member); membership, read state, mentions and reactions CASCADE.
  createdChats        Chat[]          @relation("ChatCreatedBy")
  chatMemberships     ChatMember[]
  chatReadStates      ChatReadState[]
  chatMessages        ChatMessage[]   @relation("ChatMessageAuthor")
  deletedChatMessages ChatMessage[]   @relation("ChatMessageDeletedBy")
  pinnedChatMessages  ChatMessage[]   @relation("ChatMessagePinnedBy")
  chatMentions        ChatMention[]
  chatReactions       ChatReaction[]
}

// A date (or date range) a member has marked themselves unavailable. Whole-day:
// if you're out on a date you're out for every event that day — there's no
// per-event-type granularity. The range is an inclusive span of UTC calendar
// days (single day → startDate == endDate), matching Event.date's UTC-midnight
// convention (see lib/dates.ts). Leaders read these when scheduling so an away
// member isn't put on that Sunday/rehearsal; a member can also be shown as away
// on a service they're already assigned to.
model Unavailability {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime // inclusive, UTC-midnight calendar day
  endDate   DateTime // inclusive, UTC-midnight calendar day (== startDate for one day)
  reason    String? // optional free-text ("vacation", "work")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([startDate, endDate]) // overlap lookups for "who's away on date X"
}

// A single device's Web Push subscription. One user can have several (phone,
// laptop, etc.), so subscriptions are per-device, keyed by their unique
// browser endpoint. Removed when the user is deleted or the endpoint expires.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique // the browser push endpoint — dedupe key
  p256dh    String // client public key (from subscription.keys)
  auth      String // client auth secret (from subscription.keys)
  userAgent String? // so a user can recognize which device this is
  createdAt DateTime @default(now())

  @@index([userId])
}

model Event {
  id        String        @id @default(cuid())
  eventName String
  type      EventType     @default(service)
  date      DateTime // calendar day of the occurrence
  time      String // "HH:mm" local label
  location  String
  repeats   RepeatCadence @default(once)
  notes     String?

  // Series grouping — occurrences generated from one recurring create share a seriesId.
  seriesId String?

  // Attire (optional)
  attirePrimary       String?
  attirePrimaryHex    String? // exact swatch color (#RRGGBB) for attirePrimary
  attireSecondary     String?
  attireSecondaryHex  String?
  attireComplement    String?
  attireComplementHex String?
  attireNotes         String?
  attirePhotos        String[] @default([])

  // Holy Talks (optional, holy_talks only)
  topic          String?
  scriptures     String[] @default([])
  holyTalksNotes String?

  // Rehearsal schedule (rehearsal events only) — an ordered run-of-show. Stored
  // as a JSON array of { time: "HH:mm", label: string }. Leaders edit the whole
  // list on the event form and it saves with the event (no live/auto updates,
  // unlike PrayerRequest). Null/absent on non-rehearsal events.
  rehearsalSchedule Json?

  // Prayer requests (prayer events only) — members and leaders can both add,
  // and they're visible to everyone. Removed with the event.
  prayerRequests PrayerRequest[]

  // Who sings which part (service events only). Set by a leader on the event
  // form; each occurrence of a series is assigned independently.
  assignments EventAssignment[]

  // The setlist for this event, if any. One setlist can be shared by several
  // events (e.g. a rehearsal and the service it leads into), but each event has
  // at most one — keeping "This Week's Setlist" unambiguous.
  setlistId String?
  setlist   Setlist? @relation("EventSetlist", fields: [setlistId], references: [id], onDelete: SetNull)

  // Production: which stage map this event uses (+ this week's changes) and its
  // task checklist. Both removed with the event.
  production      EventProduction?
  productionTasks ProductionTask[]

  // Crossover (the ministry's year-end event, Dec 31). A Crossover event is an
  // ordinary event tagged with its kind and the season (year) it belongs to; it
  // shows on the Crossover tab and on Events with a Crossover badge. The
  // leaders-only flag marks the Sep 1 kickoff, which members never see.
  crossoverKind        CrossoverKind?
  crossoverSeasonId    String?
  crossoverSeason      CrossoverSeason? @relation(fields: [crossoverSeasonId], references: [id], onDelete: SetNull)
  crossoverLeadersOnly Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seriesId, date]) // one occurrence per slot; makes window top-up idempotent
  @@index([date])
  @@index([seriesId])
  @@index([setlistId])
  @@index([crossoverSeasonId])
}

enum CrossoverKind {
  gnw_rehearsal
  all_team_rehearsal
  dress_rehearsal
  setup
  crossover
  other
}

// One Crossover season per year (Sep 1 – Dec 31). Created lazily the first time
// the app is used on/after Sep 1 (lib/crossover.ts → ensureCrossoverSeason),
// together with that year's kickoff, Dress Rehearsal (Dec 30) and Crossover
// (Dec 31) events; the unique year is the race lock. Later phases hang the
// season's sets, schedules and attire off this row.
model CrossoverSeason {
  id   String @id @default(cuid())
  year Int    @unique

  // "It's Crossover Season!" pushes — leaders on Sep 1, members on Oct 1. Each
  // is claimed once (null → timestamp) so overlapping cron runs can't double-send.
  leaderKickoffSentAt DateTime?
  memberKickoffSentAt DateTime?

  // Set once the season's set build (names + planned minutes) has been laid
  // down — copied from last year, or the default Opening Number / Set 1 / Set 2.
  // The flip false → true is the lock, so a leader deleting every set never
  // brings the defaults back.
  setsSeeded Boolean @default(false)

  // Schedules, each a JSON array of { time: "HH:mm", label, note? } rows, edited
  // whole by a leader: the day of Crossover (Dec 31) and the Dress Rehearsal +
  // Setup (Dec 30). Both carry over from last year when a season opens.
  dayOfSchedule Json?
  dressSchedule Json?
  // The program — the order of the night: a JSON array of items, each either a
  // set ({ setId }) or a segment ({ label }), with an optional text cue.
  program       Json?

  // This season's attire (the same fields as an event's attire).
  attirePrimary       String?
  attirePrimaryHex    String?
  attireSecondary     String?
  attireSecondaryHex  String?
  attireComplement    String?
  attireComplementHex String?
  attireNotes         String?
  attirePhotos        String[] @default([])

  events Event[]
  sets   CrossoverSet[]
  looks  CrossoverLook[]

  createdAt DateTime @default(now())
}

enum LookStatus {
  pending
  approved
  changes_requested
}

// A member's Crossover outfit, submitted for review (photos + an optional
// note). One per person per season; resubmitting updates the same row and puts
// it back to pending. Kept with the season after Crossover is over.
model CrossoverLook {
  id       String          @id @default(cuid())
  seasonId String
  season   CrossoverSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos   String[]
  note     String?
  status   LookStatus      @default(pending)

  // The reviewer's note (what to change, or a kind word). The reviewer is
  // denormalized with no FK, so removing them never touches anyone's look.
  reviewNote     String?
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([seasonId, userId])
  @@index([seasonId, status])
}

// One set in a Crossover season's setlist ("Opening Number", "Set 1", …), in
// running order. Names and planned minutes carry over to next year's season;
// songs and singers start fresh.
model CrossoverSet {
  id       String          @id @default(cuid())
  seasonId String
  season   CrossoverSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name     String
  position Int
  minutes  Int? // planned length

  songs   CrossoverSetSong[]
  singers CrossoverSetSinger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seasonId, position])
}

// A Crossover-list song placed in a set, in order. Deleting the set or the song
// removes the placement.
model CrossoverSetSong {
  id       String       @id @default(cuid())
  setId    String
  set      CrossoverSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  songId   String
  song     Song         @relation(fields: [songId], references: [id], onDelete: Cascade)
  position Int

  @@unique([setId, songId])
  @@index([setId, position])
  @@index([songId])
}

// Who sings on a set, and which part — Crossover assignments are per set, not
// per song. One part per person per set; removed with the set or the member.
model CrossoverSetSinger {
  id     String       @id @default(cuid())
  setId  String
  set    CrossoverSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  part   VocalPart

  @@unique([setId, userId])
  @@index([setId])
  @@index([userId])
}

// One member singing one part on one service. A person holds at most one part
// per event (@@unique on [eventId, userId]) — you can't sing soprano and tenor
// at once — and several people can share a part. Removed with the event or the
// member; only `service` events carry these.
model EventAssignment {
  id      String    @id @default(cuid())
  eventId String
  event   Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  part    VocalPart

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// Records a recurring-series occurrence that a leader deleted on purpose, so the
// rolling-window top-up (ensureRecurringWindow) won't re-create that date.
model SeriesSkip {
  id        String   @id @default(cuid())
  seriesId  String
  date      DateTime
  createdAt DateTime @default(now())

  @@unique([seriesId, date])
  @@index([seriesId])
}

// A prayer request attached to a prayer event. Any active user (member or
// leader) can add one; all are visible to everyone in an ongoing list.
model PrayerRequest {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Author identity is denormalized so the request still reads correctly even
  // if the user is later removed (authorId then dangles, name persists).
  authorId   String?
  authorName String
  body       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, createdAt])
}

model Setlist {
  id        String        @id @default(cuid())
  name      String? // optional display name; falls back to linked event names when empty.
  month     String // "YYYY-MM" — grouping key, derived from the earliest linked event's date.
  // A setlist can be linked to multiple events (see Event.setlist).
  events    Event[]       @relation("EventSetlist")
  // Songs are referenced from the library via the SetlistSong join, not owned
  // outright — so the same library Song (chart, vocal parts) can appear in many
  // setlists without duplicating storage. Order lives on the join's `position`.
  songs     SetlistSong[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([month])
}

// A library song — the reusable catalog entity. Entered/uploaded once and
// referenced by any number of setlists through SetlistSong. Heavy assets
// (audio parts, lyric doc) are stored as URLs into the Supabase bucket, so a
// row is only a few KB of text and the audio is stored once regardless of how
// many setlists use the song. Retiring a song (and freeing its bucket files) is
// a deliberate delete; setlists coming and going never touch it.
model Song {
  id                  String    @id @default(cuid())
  songTitle           String
  artist              String? // original artist / arranger
  youtubeLink         String?
  audioSoprano        String?
  audioAlto           String?
  audioTenor          String?
  audioAllParts       String?
  // Band content. `arrangementAudio` is a single audio file that behaves exactly
  // like a vocal part (uploaded to storage, played in-app); `songKey`/`bpm` are
  // free-text, leader-editable from the band song card.
  arrangementAudio    String?
  songKey             String?
  bpm                 String?
  // Lyric chart imported from a Google Doc. `lyricChart` holds the parsed
  // structured chart (see lib/parseGoogleDoc.ts); `lyricDocUrl` remembers the
  // source doc for re-imports; `lyricChartUpdatedAt` tracks the last import.
  lyricChart          Json?
  lyricDocUrl         String?
  lyricChartUpdatedAt DateTime?
  // The date of the newest setlist that named a leader for this song (that
  // setlist's earliest linked event). Guards the memory in `lastLeads` against
  // being overwritten by an edit to an *older* setlist. Null → never led.
  lastLeadAt          DateTime?
  // Which list the song lives in: the Song Library, or the separate Crossover
  // song list (Crossover arrangements differ, so they never mix). Moving a song
  // between lists copies it; the copy shares the original's audio files, which
  // is why file cleanup checks for other songs still using a URL.
  scope               SongScope @default(library)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  setlistSongs      SetlistSong[] // placements of this song across setlists
  lastLeads         SongLastLead[] // remembered leaders — see SongLastLead
  suggestions       SongSuggestion[] // suggestions a leader turned into this song
  crossoverSetSongs CrossoverSetSong[] // placements in Crossover sets (crossover-scope songs)

  @@index([songTitle]) // library browse/search by title
  @@index([scope, songTitle])
}

enum SongScope {
  library
  crossover
}

// Where a song suggestion stands. `added` = a leader turned it into a library
// Song; `dismissed` = a leader passed on it (shown as "Passed" in the UI).
enum SuggestionStatus {
  open
  added
  dismissed
}

// A song someone thinks the team should sing, submitted as just a YouTube link.
// Title/artist are guessed from the video's oEmbed metadata (lib/youtube.ts)
// and may have been corrected by the suggester; the raw video title + channel
// are kept alongside so a bad guess can be re-read. Visible to the whole team.
model SongSuggestion {
  id          String  @id @default(cuid())
  // The 11-char YouTube video id — the duplicate-detection key.
  videoId     String
  url         String // canonical https://www.youtube.com/watch?v=<videoId>
  songTitle   String
  artist      String?
  videoTitle  String?
  channelName String?

  // Author denormalized with no FK, like PrayerRequest: removing a member never
  // has to clear their suggestions first, and the name still reads correctly.
  suggestedById   String?
  suggestedByName String

  status SuggestionStatus @default(open)
  // The library Song created from this suggestion ("Add to library").
  songId String?
  song   Song?            @relation(fields: [songId], references: [id], onDelete: SetNull)
  // Which list it's a suggestion for: the Song Library, or Crossover (whose
  // "Add" creates a Crossover-list song instead).
  scope  SongScope        @default(library)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([videoId])
  @@index([scope, status, createdAt])
}

// Join between a Setlist and a library Song: where the song sits (and in what
// order) within one setlist. Deleting the setlist or the library song removes
// the link; the library Song — and its audio in storage — otherwise persists.
model SetlistSong {
  id        String   @id @default(cuid())
  setlistId String
  setlist   Setlist  @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  songId    String
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  position  Int // ordering within the setlist
  createdAt DateTime @default(now())

  // Who leads this song *this time around* (see SongLead).
  leads SongLead[]

  @@unique([setlistId, songId]) // a song appears at most once per setlist
  @@index([setlistId, position])
  @@index([songId])
}

// Who leads a song for one setlist. Deliberately hangs off SetlistSong, not
// Song: leads switch off, so it's a property of the placement ("Great Are You
// Lord, Aug 16"), not of the library entry. Several people can share a song
// (co-leads), hence a join table rather than a column.
model SongLead {
  id            String      @id @default(cuid())
  setlistSongId String
  setlistSong   SetlistSong @relation(fields: [setlistSongId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([setlistSongId, userId]) // one lead row per person per placement
  @@index([setlistSongId])
  @@index([userId])
}

// The library song's memory of who led it last — the set pre-filled when the
// song is added to a new setlist.
//
// It exists as its own table because SongLead can't be the source of truth for
// it: pruneExpiredSetlists() deletes a setlist once all its events have passed,
// cascading that Sunday's SongLead rows away. The memory has to outlive the
// setlist that produced it, so every setlist save copies its leads here, and
// `Song.lastLeadAt` records which setlist's date the copy came from.
model SongLastLead {
  id        String   @id @default(cuid())
  songId    String
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([songId, userId])
  @@index([songId])
  @@index([userId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  // Pinned announcements sort to the top of everyone's feed and get a
  // highlighted treatment. Toggled by a leader from the Home screen.
  pinned    Boolean  @default(false)
  // The leader who posted it — surfaced as author name + avatar on the card.
  // Nullable so pre-existing posts (and posts by a since-removed user) still show.
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  expiresAt DateTime // required; max 10 days from createdAt (enforced in UI + API)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@index([pinned])
}

// A team poll created by a leader. Pops up as a blocking prompt for the whole
// team (members + leaders) until each user votes. Results become visible to a
// user the moment they vote (public results); leaders can download the
// distribution once the poll has ended (past `endsAt`).
model Poll {
  id        String       @id @default(cuid())
  question  String
  // Whether a voter may pick more than one choice.
  multiple  Boolean      @default(false)
  // When the poll closes. After this it no longer blocks/accepts votes; leaders
  // can review and download results.
  endsAt    DateTime
  choices   PollChoice[]
  votes     PollVote[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([endsAt])
}

model PollChoice {
  id       String     @id @default(cuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  position Int // ordering within the poll
  text     String
  votes    PollVote[]

  @@index([pollId, position])
}

// One row per (user, choice) selection. A single-answer poll yields one row per
// voter; a multiple-answer poll can yield several. The presence of any row for
// (pollId, userId) means that user has voted.
model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  choiceId  String
  choice    PollChoice @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  // Voter identity kept for one-vote-per-person enforcement and turnout counts.
  // Not a FK to User so a removed user's tallies still stand.
  userId    String
  createdAt DateTime   @default(now())

  @@unique([pollId, userId, choiceId]) // can't pick the same choice twice
  @@index([pollId, userId])
  @@index([choiceId])
}

// ===========================================================================
// GNW Play — real-time quiz game. Lives under /app/play. Server (API routes) is
// the single source of truth for timestamps, scoring, and round state; Supabase
// Realtime Broadcast is only the fast push layer on channel `game:${sessionId}`.
// ===========================================================================

// A reusable set of questions a leader authors in the Pack Builder.
model QuestionPack {
  id          String        @id @default(cuid())
  // Author. Packs are owned content, so they're removed with their creator.
  createdById String?
  creator     User?         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  name        String
  questions   Question[]
  sessions    GameSession[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([createdById, updatedAt])
}

model Question {
  id            String       @id @default(cuid())
  packId        String
  pack          QuestionPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  type          QuestionType
  questionText  String
  // MCQ: array of 4 strings. T/F: always ["True","False"].
  options       Json
  // The correct option string, exactly as it appears in `options`.
  correctAnswer String
  orderIndex    Int
  answers       GameAnswer[]
  createdAt     DateTime     @default(now())

  @@index([packId, orderIndex])
}

// One live (or finished) play-through of a pack. Only one session may be in a
// non-ended state across all of Hub at a time (enforced in the API, not the DB).
model GameSession {
  id                   String        @id @default(cuid())
  packId               String
  pack                 QuestionPack  @relation(fields: [packId], references: [id])
  hostId               String
  host                 User          @relation(fields: [hostId], references: [id])
  mode                 GameMode
  status               SessionStatus @default(lobby)
  // { time_per_question, shuffle, team_names? }
  settings             Json
  // Ordered array of question IDs as they will be played.
  questionOrder        Json
  currentQuestionIndex Int           @default(0)
  guestAccessEnabled   Boolean       @default(false)
  guestLinkToken       String?       @unique

  players    GamePlayer[]
  answers    GameAnswer[]
  teams      GameTeam[]
  roundState RoundState?

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([status])
}

// A seat in a session: a Hub user or a named guest (userId null).
model GamePlayer {
  id               String      @id @default(cuid())
  sessionId        String
  session          GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName        String? // used only when userId is null
  team             String? // team_battle only
  hearts           Int         @default(3) // survival only
  isEliminated     Boolean     @default(false)
  isSpectator      Boolean     @default(false)
  playPointsEarned Int         @default(0)
  joinedAt         DateTime    @default(now())

  answers GameAnswer[]

  @@index([sessionId])
  @@index([userId])
}

model GameAnswer {
  id           String      @id @default(cuid())
  sessionId    String
  session      GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId     String
  player       GamePlayer  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question    @relation(fields: [questionId], references: [id])
  answer       String
  // ALWAYS server-recorded (Date.now() in the API route); never client-supplied.
  submittedAt  DateTime
  isCorrect    Boolean?
  // submittedAt − round_state.questionStartAt, computed on the server.
  timeTakenMs  Int?
  pointsEarned Int         @default(0)

  @@unique([playerId, questionId]) // one answer per player per question
  @@index([sessionId, questionId])
}

// Per-session round clock + lifecycle. One row per session (PK = sessionId).
model RoundState {
  sessionId       String      @id
  session         GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Set when the server starts a question; the timing anchor for speed scoring.
  questionStartAt DateTime?
  roundNumber     Int         @default(0)
  status          RoundStatus @default(between_rounds)
}

model GameTeam {
  id         String      @id @default(cuid())
  sessionId  String
  session    GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name       String
  teamPoints Int         @default(0)

  @@index([sessionId])
}

// ===========================================================================
// Calls — leader-initiated live voice/video rooms (LiveKit Cloud). First pass:
// a leader starts a named call, everyone may join (no invite gating yet), and
// a push notification fans out to the whole team. Room media itself lives in
// LiveKit; this row is the discoverable record + audit trail.
// ===========================================================================
model Call {
  id       String       @id @default(cuid())
  name     String // leader-entered call name (free text)
  roomName String       @unique // LiveKit room identifier (unique slug)
  status   CallStatus   @default(active)
  audience CallAudience @default(all_members) // who may join (see CallAudience)

  // The leader who started the call. Kept as a required FK (the starter always
  // has the leader role, verified server-side at creation).
  startedById String
  startedBy   User   @relation(fields: [startedById], references: [id])

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([status])
}

// ===========================================================================
// Production — how Sunday's gear connects (the Stage Map) and who sets up what
// (per-event task checklists). Encounter Night and "Other" events use the same
// tables; "Other" is checklist-only (no stage map).
// ===========================================================================
enum ProductionKind {
  service
  encounter_night
  other
}

// A venue's base setup — gear, ports, cables, zones and layout — reused every
// week. Stored as one JSON document (shape in lib/stage-map.ts) because it's
// always read and edited whole, and leader quick-adds ("Add mic") only append
// to it. `active` marks the map new events pick up for that kind.
model StageMap {
  id     String         @id @default(cuid())
  name   String // e.g. "Hotel — Sunday Service"
  venue  String // e.g. "Hotel"; a new building gets its own map
  kind   ProductionKind
  active Boolean        @default(true)
  data   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventProductions EventProduction[]

  @@index([kind, active])
}

// One event's production state: the stage map it uses plus this week's changes
// on top of it (the ~10% that differs — a guest drummer, an extra mic). The
// map itself is never edited per event; `changes` is a list of edits applied
// over it at read time (shape in lib/stage-map.ts). Removed with the event.
model EventProduction {
  eventId    String    @id
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stageMapId String?
  stageMap   StageMap? @relation(fields: [stageMapId], references: [id], onDelete: SetNull)
  changes    Json?

  // When the "your production tasks start soon" push went out (30 min before
  // the event). Set once so the every-few-minutes reminder job never repeats it.
  remindedAt DateTime?

  updatedAt DateTime @updatedAt

  @@index([stageMapId])
}

// A reusable checklist for one production kind (Service, Encounter Night…).
// Its tasks are copied onto an event's checklist when production is set up.
model ProductionTemplate {
  id    String                   @id @default(cuid())
  name  String
  kind  ProductionKind
  tasks ProductionTemplateTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

model ProductionTemplateTask {
  id         String             @id @default(cuid())
  templateId String
  template   ProductionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  zone       String? // stage-map zone key (lib/stage-map.ts); null = general
  title      String
  notes      String?
  sortOrder  Int                @default(0)

  eventTasks ProductionTask[]

  @@index([templateId])
}

// One task on one event's checklist — copied from a template or added ad hoc
// by a leader. Owners are optional and leader-assigned; a new event's owner
// defaults to whoever owned the same template task on the previous event of
// the same type (matched on templateTaskId). Members check off their own
// tasks; leaders can check off anything. Both user links are SET NULL so
// removing a member never fails.
model ProductionTask {
  id             String                  @id @default(cuid())
  eventId        String
  event          Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateTaskId String?
  templateTask   ProductionTemplateTask? @relation(fields: [templateTaskId], references: [id], onDelete: SetNull)
  zone           String?
  title          String
  notes          String?
  sortOrder      Int                     @default(0)

  ownerId String?
  owner   User?   @relation("ProductionTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  doneAt   DateTime?
  doneById String?
  doneBy   User?     @relation("ProductionTaskDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([ownerId])
  @@index([templateTaskId])
}

// ── Chat (replacing GroupMe) ─────────────────────────────────────────────────
// Plan, decisions and phase status: Docs/Chat-Feature.md.
//
// One table holds chats AND topics (a topic is a Chat with a parentId), so every
// message has a single chatId. Membership lives on the root chat only — topics
// are open to everyone in their parent. Content never rides Supabase Realtime:
// writes go through the API, then a content-free ping tells clients to refetch
// (lib/chat/realtime-server.ts).
//
// Search (Phase 3) uses an expression GIN index on to_tsvector('english', text)
// created in raw SQL (migration 20261105000000_add_chat). Prisma can't declare
// it — keep it when hand-writing future migrations.

enum ChatAttachmentKind {
  image
  video
  file // a PDF (shown as a file card, opened in the phone's viewer)
}

model Chat {
  id            String    @id @default(cuid())
  name          String
  // null = a chat; set = a topic inside that chat (one level deep only).
  parentId      String?
  parent        Chat?     @relation("ChatTopics", fields: [parentId], references: [id], onDelete: Cascade)
  topics        Chat[]    @relation("ChatTopics")
  // Order of topics within their chat (chats themselves sort by activity).
  position      Int       @default(0)
  // Archived = hidden from the chat list and read-only. Moderators only.
  archivedAt    DateTime?
  createdById   String?
  createdBy     User?     @relation("ChatCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // Time of the newest message here (denormalized on send/import) — sorts the list.
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members    ChatMember[]
  readStates ChatReadState[]
  messages   ChatMessage[]

  @@index([parentId])
}

// Who is in a (root) chat. Managed by hand per chat, not derived from role.
model ChatMember {
  id       String    @id @default(cuid())
  chatId   String
  chat     Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Set = muted (no pushes, except @mentions of you and @all). Covers its topics.
  mutedAt  DateTime?
  joinedAt DateTime  @default(now())

  @@unique([chatId, userId])
  @@index([userId])
}

// Per user, per chat-or-topic: how far they've read (drives unread badges) and
// whether they're looking at it right now (skips the push).
model ChatReadState {
  id         String    @id @default(cuid())
  chatId     String
  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime  @default(now())
  // Heartbeat from the open chat screen; a push is skipped if this is recent.
  viewingAt  DateTime?

  @@unique([chatId, userId])
  @@index([userId])
}

model ChatMessage {
  id                   String        @id @default(cuid())
  chatId               String
  chat                 Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  // Null for imported messages from people who aren't Hub members (and if a
  // member is ever removed) — shown under importedAuthorName as a former member.
  authorId             String?
  author               User?         @relation("ChatMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  importedAuthorName   String?
  importedAuthorAvatar String?
  // Null for a photo/video-only message.
  text                 String?
  replyToId            String?
  replyTo              ChatMessage?  @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies              ChatMessage[] @relation("ChatReplies")
  // @all (leaders + moderators only; breaks through mute).
  mentionsAll          Boolean       @default(false)
  editedAt             DateTime?
  // Soft delete: the row stays (replies keep their anchor), text is withheld.
  deletedAt            DateTime?
  deletedById          String?
  deletedBy            User?         @relation("ChatMessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  pinnedAt             DateTime?
  pinnedById           String?
  pinnedBy             User?         @relation("ChatMessagePinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)
  // Client-generated id for a send, so a retried request never posts twice.
  clientNonce          String?       @unique
  // Where an imported message came from ('groupme') + its id there. Unique
  // together, so the import can be re-run for the final delta without duplicates.
  importSource         String?
  importId             String?
  createdAt            DateTime      @default(now())

  mentions    ChatMention[]
  attachments ChatAttachment[]
  reactions   ChatReaction[]

  @@unique([importSource, importId])
  @@index([chatId, createdAt])
  @@index([authorId])
}

model ChatMention {
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

// A photo, video or PDF on a message. Files live in the PRIVATE `gnw-chat`
// bucket (SUPABASE_CHAT_BUCKET); store the storage path, never a URL — reads
// get short-lived signed URLs.
model ChatAttachment {
  id          String             @id @default(cuid())
  messageId   String
  message     ChatMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind        ChatAttachmentKind
  path        String
  name        String? // the original file name, for files ("Setlist.pdf")
  posterPath  String? // video poster frame
  width       Int?
  height      Int?
  durationSec Float?
  sizeBytes   Int?
  position    Int                @default(0)
  createdAt   DateTime           @default(now())

  @@index([messageId])
}

model ChatReaction {
  id             String      @id @default(cuid())
  messageId      String
  message        ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // Null for an imported reaction from someone who isn't a Hub member; then
  // importedUserId holds their GroupMe user id (so re-imports don't duplicate).
  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  importedUserId String?
  emoji          String
  createdAt      DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@unique([messageId, importedUserId, emoji])
  @@index([userId])
}
